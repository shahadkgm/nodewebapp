<!-- views/partials/admin/footer.ejs -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const contentWrapper = document.querySelector('.content-wrapper');
        
        sidebar.classList.toggle('active');
        
        if (sidebar.classList.contains('active')) {
            contentWrapper.style.marginLeft = '0';
        } else {
            contentWrapper.style.marginLeft = window.innerWidth > 768 ? '200px' : '0';
        }
    }
    
    // Initialize responsiveness
    window.addEventListener('resize', function() {
        const sidebar = document.getElementById('sidebar');
        const contentWrapper = document.querySelector('.content-wrapper');
        
        if (window.innerWidth <= 768) {
            contentWrapper.style.marginLeft = '0';
        } else {
            contentWrapper.style.marginLeft = sidebar.classList.contains('active') ? '0' : '200px';
        }
    });
    
    // Initial check
    if (window.innerWidth <= 768) {
        document.querySelector('.content-wrapper').style.marginLeft = '0';
    }
</script>
</body>
</html>
