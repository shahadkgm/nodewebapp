<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding-top: 60px;
            overflow-x: hidden;
        }
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 15px;
            background: linear-gradient(135deg, #146c43 0%, #29a033 61%);
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .navbar h1 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 600;
        }
        .navbar .btn-danger {
            padding: 0.375rem 0.75rem;
            font-size: 0.9rem;
        }
        .navbar .btn-danger a {
            color: white;
            text-decoration: none;
        }
        .menu-toggle {
            font-size: 1.5rem;
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            display: none;
        }
        .sidebar {
            background: linear-gradient(135deg, #146c43 0%, #29a033 61%);
            padding: 15px;
            width: 200px;
            height: calc(100vh - 60px);
            position: fixed;
            top: 60px;
            left: 0;
            overflow-y: auto;
            transition: transform 0.3s ease-in-out;
            z-index: 999;
        }
        .sidebar a {
            color: white;
            display: flex;
            align-items: center;
            padding: 10px;
            margin-bottom: 5px;
            text-decoration: none;
            border-radius: 4px;
            font-size: 0.95rem;
            transition: background-color 0.2s;
        }
        .sidebar a:hover {
            background-color: #495057;
        }
        .sidebar i {
            margin-right: 10px;
            font-size: 1.1rem;
        }

        @media (max-width: 991px) {
            .navbar h1 { font-size: 1.25rem; }
            .sidebar { width: 180px; }
        }
        @media (max-width: 768px) {
            .menu-toggle { display: block; }
            .sidebar { transform: translateX(-100%); width: 250px; box-shadow: 2px 0 5px rgba(0, 0, 0, 0.2); }
            .sidebar.active { transform: translateX(0); }
            .navbar { padding: 8px 10px; }
            .navbar h1 { font-size: 1.1rem; }
            .sidebar a { font-size: 0.9rem; padding: 8px; }
            .sidebar i { font-size: 1rem; }
        }
        @media (max-width: 576px) {
            .navbar { padding: 6px 8px; }
            .navbar h1 { font-size: 1rem; }
            .menu-toggle { font-size: 1.25rem; }
            .sidebar { width: 200px; }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <button class="menu-toggle" aria-label="Toggle sidebar" onclick="toggleSidebar()">☰</button>
        <h1>Admin Dashboard</h1>
        <button class="btn btn-danger">
            <a href="/admin/logout">Logout</a>
        </button>
    </nav>
    <div class="sidebar" id="sidebar">
        <a href="/admin/"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
        <a href="/admin/users"><i class="fas fa-users"></i> Customers</a>
        <a href="/admin/Category"><i class="fas fa-list"></i> Category</a>
        <a href="/admin/products"><i class="fas fa-boxes"></i> Products</a>
        <a href="/admin/Coupon"><i class="fas fa-tags"></i> Coupon</a>
        <a href="/admin/Orders"><i class="fas fa-shopping-cart"></i> Orders</a>
        <a href="/admin/Wallets"><i class="fas fa-wallet"></i> Wallet</a>
    </div>