<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="author" content="Untree.co">
  <meta name="description" content="" />
  <meta name="keywords" content="bootstrap, bootstrap4" />

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

  <!-- Tiny Slider -->
  <link href="css/tiny-slider.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="css/style.css" rel="stylesheet">

  <title>Woodie</title>

  <style>
    /* Header styles */
    .header {
      position: relative;
      z-index: 500;
    }

    /* Base navbar styles */
    .custom-navbar {
      background-color: #3b5d50 !important;
    }

    .custom-navbar .navbar-brand {
      font-size: clamp(24px, 5vw, 32px);
      font-weight: 600;
      color: #ffffff;
    }

    .custom-navbar .navbar-brand span {
      opacity: 0.4;
    }

    /* Navbar nav items */
    .custom-navbar-nav {
      align-items: center;
      gap: 1rem;
    }

    .custom-navbar-nav .nav-link {
      color: #ffffff !important;
      opacity: 0.5;
      font-weight: 500;
      transition: opacity 0.3s ease;
      padding: 0.5rem 0;
    }

    .custom-navbar-nav .nav-link:hover,
    .custom-navbar-nav .nav-link.active {
      opacity: 1;
    }

    /* Dropdown styles */
    .dropdown {
      position: relative;
    }

    .dropdown-toggle {
      color: #ffffff !important;
      opacity: 0.5;
      font-weight: 500;
      transition: opacity 0.3s ease;
      background: none;
      border: none;
      padding: 0.5rem 0;
    }

    .dropdown-toggle:hover,
    .dropdown-toggle:focus {
      opacity: 1;
    }

    .dropdown-menu {
      background-color: #3b5d50;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      min-width: 160px;
      margin-top: 0.5rem;
      border: none;
    }

    .dropdown-item {
      color: #ffffff;
      padding: 0.75rem 1rem;
      transition: background-color 0.3s ease;
    }

    .dropdown-item:hover,
    .dropdown-item:focus {
      background-color: #1a1919;
      color: #ffffff;
    }

    /* CTA icons */
    .custom-navbar-cta {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .custom-navbar-cta .nav-link {
      color: #ffffff !important;
      opacity: 0.5;
      padding: 0.5rem;
      transition: opacity 0.3s ease;
    }

    .custom-navbar-cta .nav-link:hover {
      opacity: 1;
    }

    /* Mobile-specific styles */
    @media (max-width: 767px) {
      .custom-navbar-nav {
        padding: 1rem 0;
      }

      .dropdown-menu {
        min-width: 100%;
      }

      .custom-navbar-cta {
        margin-top: 1rem;
      }
    }

    /* Medium and larger screens */
    @media (min-width: 768px) {
      .custom-navbar-nav {
        gap: 1.5rem;
      }

      .custom-navbar-cta {
        margin-left: 2rem;
      }

      .dropdown-toggle::after {
        border-color: #ffffff;
        opacity: 0.5;
      }
    }

    @media (min-width: 992px) {
      .custom-navbar-nav .nav-link {
        position: relative;
      }

      .custom-navbar-nav .nav-link::before {
        content: "";
        position: absolute;
        bottom: 0;
        left: 8px;
        right: 8px;
        background: #f9bf29;
        height: 5px;
        opacity: 0;
        visibility: hidden;
        width: 0;
        transition: all 0.15s ease-out;
      }

      .custom-navbar-nav .nav-link:hover::before,
      .custom-navbar-nav .nav-link.active::before {
        opacity: 1;
        visibility: visible;
        width: calc(100% - 16px);
      }
    }
  </style>
</head>
<body>
  <!-- Start Header/Navigation -->
  <nav class="custom-navbar navbar navbar-expand-md navbar-dark" aria-label="Woodie navigation bar">
    <div class="container">
      <a class="navbar-brand" href="/index">WOODIE<span>.</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarsFurni" aria-controls="navbarsFurni" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarsFurni">
        <ul class="custom-navbar-nav navbar-nav ms-auto mb-2 mb-md-0">
          <li class="nav-item active"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
          <% if (locals.user) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <%= locals.user.name %>
              </a>
              <ul class="dropdown-menu" aria-labelledby="userDropdown">
                <li><a class="dropdown-item" href="/userProfile">Profile</a></li>
                <li><a class="dropdown-item" href="/logout">Logout</a></li>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/signup">Sign up</a></li>
            <li class="nav-item"><a class="nav-link" href="/Login">Log in</a></li>
          <% } %>
        </ul>
        <ul class="custom-navbar-cta navbar-nav mb-2 mb-md-0">
          <li><a class="nav-link" href="/wishlist"><i class="fas fa-heart"></i></a></li>
          <li><a class="nav-link" href="/cart"><img src="/images/cart.svg" alt="Cart"></a></li>
        </ul>
      </div>
    </div>
  </nav>
  <!-- End Header/Navigation -->

  <!-- Bootstrap JS (make sure to include this at the end of the body) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
</body>
</html>