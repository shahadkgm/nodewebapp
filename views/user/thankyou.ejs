<%- include("../../views/partials/user/header") %>
<%if(order.status === 'Payment Failed'||order.status==='Payment Pending'){%>
    <div class="hero bg-light py-5 text-center">
        <div class="container">
            <h1 class="fw-bold text-danger">Payment Failed!</h1>
            <p class="lead">We couldn't process your payment. Please try again.</p>
        </div>
    </div>
    <!-- End Hero Section -->
    
    <div class="container my-5 text-center">
        <div class="card mx-auto shadow p-4" style="max-width: 500px;">
            <div class="card-body">
                <span class="display-3 text-danger">
                    <i class="fa-solid fa-circle-xmark"></i>
                </span>
                <h2 class="mt-3">Transaction Unsuccessful</h2>
                <p class="lead text-muted">Your payment was not completed. Please check your details and try again.</p>
                <div class="mt-4">
                    <a href="/userProfile?tab=orders&paymentStatus=failed" class="btn btn-outline-danger">Order page</a>
                    <a href="/shop" class="btn btn-danger">Back to Shop</a>
                </div>
            </div>
        </div>
    </div>
<%}else{%>
<!-- Start Hero Section -->
<div class="hero bg-light py-5 text-center">
    <div class="container">
        <h1 class="fw-bold text-success">Thank You for Your Purchase!</h1>
        <p class="lead">Your order has been successfully placed. We appreciate your business!</p>
    </div>
</div>
<!-- End Hero Section -->

<div class="container my-5 text-center">
    <div class="card mx-auto shadow p-4" style="max-width: 500px;">
        <div class="card-body">
            <span class="display-3 text-success">
                <i class="fa-solid fa-circle-check"></i>
            </span>
            <h2 class="mt-3">Order Confirmed</h2>
            <p class="lead text-muted">You will receive a confirmation email with order details.</p>
            <div class="mt-4">
                <a href="/orders" class="btn btn-outline-success">View My Orders</a>
                <a href="/shop" class="btn btn-success">Continue Shopping</a>
            </div>
        </div>
    </div>
</div>
<%}%>
<!-- Start Footer Section -->
<%- include("../../views/partials/user/footer") %>
