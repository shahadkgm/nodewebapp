<%- include("../../views/partials/admin/header") %>

<div class="content-wrapper" style="margin-left: 200px; padding: 20px; transition: margin-left 0.3s ease-in-out;">
  <section class="content-main">
    <div class="content-header d-flex justify-content-between align-items-center flex-wrap">
      <h2 class="content-title card-title">Products</h2>
      <a href="/admin/addproducts" class="btn btn-success">
        <i class="fas fa-plus me-2"></i> Add Product
      </a>
    </div>

    <header class="card-header text-center mb-3">
      <form action="" method="get" class="d-flex justify-content-center">
        <div class="input-group border border-secondary rounded-pill shadow-sm w-100" style="max-width: 500px;">
          <input type="text" class="form-control border-0 rounded-pill px-3" placeholder="Search products" name="search" value="<%= search %>"/>
          <button class="btn btn-success rounded-pill px-4" type="submit">Search</button>
        </div>
      </form>
    </header>

    <div class="card">
      <div class="card-body">
        <% if (data.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover table-bordered shadow-sm">
            <thead class="table-success text-center">
              <tr>
                <th>Product Name</th>
                <th>Product Image</th>
                <th>Category</th>
                <th>Regular Price</th>
                <th>Sale Price</th>
                <th>Offer (%)</th>
                <th>Offer Action</th>
                <th>Quantity</th>
                <th>Action</th>
                <th>Edit</th>
              </tr>
            </thead>
            <tbody class="text-center">
              <% for(let i = data.length - 1; i >= 0; i--) { %>
              <tr>
                <td class="text-start"><%= data[i].productName %></td>
                <td><img src="/uploads/product-images/<%= data[i].productImage[0] %>" class="img-fluid" style="max-width: 80px; max-height: 80px;"></td>
                <td><%= data[i].category ? data[i].category.name : 'No Category' %></td>
                <td>₹<%= data[i].regularPrice %></td>
                <td>₹<%= data[i].salePrice %></td>
                <td><%= data[i].productOffer || 0 %>%</td>
                <td>
                  <% if (!data[i].productOffer || data[i].productOffer === 0) { %>
                  <button class="btn btn-info btn-sm w-100" onclick="addOffer('<%= data[i]._id %>')">Add Offer</button>
                  <% } else { %>
                  <button class="btn btn-danger btn-sm w-100" onclick="removeOffer('<%= data[i]._id %>')">Remove</button>
                  <% } %>
                </td>
                <td><%= data[i].quantity %></td>
                <td>
                  <% if (data[i].isBlocked === false) { %>
                  <button class="btn btn-danger btn-sm w-100" onclick="blockProduct('<%= data[i]._id %>')">Block</button>
                  <% } else { %>
                  <button class="btn btn-success btn-sm w-100" onclick="unblockProduct('<%= data[i]._id %>')">Unblock</button>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/editProduct?id=<%= data[i]._id %>" class="btn btn-info btn-sm w-100 text-white">Edit</a>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <div class="card text-center text-white bg-danger mx-auto mt-3" style="max-width: 50rem;">
          <div class="card-body">
            <h5 class="card-title">Try Again</h5>
            <p class="card-text">Oops! Nothing found related to your query.</p>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <div class="container mt-3">
      <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
          <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>&search=<%= search %>"><%= i %></a>
          </li>
          <% } %>
        </ul>
      </nav>
    </div>
  </section>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>
async function addOffer(productId) {
  const { value: percentage } = await Swal.fire({
    title: "Offer in Percentage",
    input: 'number',
    inputLabel: 'Enter percentage (%)',
    inputPlaceholder: 'e.g., 20',
    inputAttributes: { min: 1, max: 100 },
    showCancelButton: true,
  });

  if (percentage) {
    $.ajax({
      url: "/admin/addProductOffer",
      method: 'POST',
      data: { percentage, productId },
      success: (response) => {
        if (response.status === true) {
          Swal.fire('Offer Added', 'The offer has been applied successfully.', 'success').then(() => {
            location.reload();
          });
        } else {
          Swal.fire('Failed', response.message || 'Failed to add offer.', 'error');
        }
      },
      error: (xhr, status, error) => {
        Swal.fire('Error', 'An error occurred while adding the offer.', 'error');
      }
    });
  }
}

function removeOffer(productId) {
  Swal.fire({
    title: 'Remove Offer',
    text: 'Are you sure you want to remove this offer?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#3085d6',
    cancelButtonColor: '#d33',
    confirmButtonText: 'Yes, remove it!'
  }).then((result) => {
    if (result.isConfirmed) {
      $.ajax({
        url: "/admin/removeProductOffer",
        method: 'POST',
        data: { productId },
        success: (response) => {
          if (response.status === true) {
            Swal.fire('Removed!', 'The offer has been removed.', 'success').then(() => {
              location.reload();
            });
          } else {
            Swal.fire('Failed', 'Failed to remove offer.', 'error');
          }
        },
        error: (xhr, status, error) => {
          Swal.fire('Error', 'An error occurred while removing the offer.', 'error');
        }
      });
    }
  });
}

function blockProduct(productId) {
  Swal.fire({
    title: 'Are you sure?',
    text: "You won't be able to revert this action!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, block it!',
    cancelButtonText: 'No, cancel!',
    reverseButtons: true
  }).then((result) => {
    if (result.isConfirmed) {
      $.ajax({
        url: `/admin/blockProduct?id=${productId}`, 
        method: 'GET',
        data: { id: productId },
        success: function(response) {
          if (response.status === true) {
            Swal.fire(
              'Blocked!',
              'The product has been blocked.',
              'success'
            ).then(() => {
              location.reload(); 
            });
          } else {
            Swal.fire(
              'Failed!',
              'An error occurred while blocking the product.',
              'error'
            );
          }
        }
      });
    }
  });
}

function unblockProduct(productId) {
  Swal.fire({
    title: 'Are you sure?',
    text: "You can unblock it later.",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, unblock it!',
    cancelButtonText: 'No, cancel!',
    reverseButtons: true
  }).then((result) => {
    if (result.isConfirmed) {
      $.ajax({
        url: "/admin/unblockProduct",
        method: 'GET',
        data: { id: productId },
        success: function(response) {
          if (response.status === true) {
            Swal.fire(
              'Unblocked!',
              'The product has been unblocked.',
              'success'
            ).then(() => {
              location.reload();
            });
          } else {
            Swal.fire(
              'Failed!',
              'An error occurred while unblocking the product.',
              'error'
            );
          }
        }
      });
    }
  });
}

// Toggle sidebar function
function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  const contentWrapper = document.querySelector('.content-wrapper');
  
  sidebar.classList.toggle('active');
  
  if (sidebar.classList.contains('active')) {
    contentWrapper.style.marginLeft = window.innerWidth <= 768 ? '0' : '0';
  } else {
    contentWrapper.style.marginLeft = window.innerWidth <= 768 ? '0' : '200px';
  }
}

// Initialize responsiveness
window.addEventListener('load', function() {
  const sidebar = document.getElementById('sidebar');
  const contentWrapper = document.querySelector('.content-wrapper');
  const menuToggle = document.querySelector('.menu-toggle');
  
  if (menuToggle) {
    menuToggle.addEventListener('click', toggleSidebar);
  }
  
  if (window.innerWidth <= 768) {
    contentWrapper.style.marginLeft = '0';
  }
});

window.addEventListener('resize', function() {
  const sidebar = document.getElementById('sidebar');
  const contentWrapper = document.querySelector('.content-wrapper');
  
  if (window.innerWidth <= 768) {
    contentWrapper.style.marginLeft = '0';
  } else {
    contentWrapper.style.marginLeft = sidebar.classList.contains('active') ? '0' : '200px';
  }
});
</script>

<style>
  .content-wrapper {
    margin-left: 200px;
    padding: 20px;
    transition: margin-left 0.3s ease-in-out;
  }
  
  @media (max-width: 991px) {
    .content-wrapper {
      margin-left: 180px;
    }
  }
  
  @media (max-width: 768px) {
    .content-wrapper {
      margin-left: 0;
    }
  }
</style>

<%- include("../../views/partials/admin/footer") %>