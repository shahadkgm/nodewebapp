<%- include('../partials/admin/header') %>

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>

<style>
    /* Content Styling */
    .content-main {
        margin-left: 220px;
        padding: 20px;
        transition: margin-left 0.3s ease-in-out;
        min-height: calc(100vh - 60px);
    }
    .content-header {
        margin-bottom: 20px;
    }
    .content-title {
        font-size: 1.75rem;
        color: #333;
    }

    /* Card Styling */
    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 1rem;
        cursor: pointer;
    }
    .card-body {
        padding: 1.5rem;
    }

    /* Form Styling */
    .form-label {
        font-weight: 500;
        color: #333;
        margin-bottom: 8px;
    }
    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #ccc;
        padding: 10px;
        transition: all 0.3s ease-in-out;
    }
    .form-control:focus, .form-select:focus {
        border-color: #007bff;
        box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.3);
    }

    /* Button Styling */
    .btn-primary {
        background-color: #007bff;
        border-radius: 8px;
        padding: 10px;
        transition: all 0.3s ease-in-out;
    }
    .btn-primary:hover {
        background-color: #0056b3;
    }
    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
        border-radius: 8px;
        padding: 10px;
        transition: all 0.3s ease-in-out;
    }
    .btn-outline-secondary:hover {
        background-color: #6c757d;
        color: #fff;
    }
    .btn-outline-primary {
        border-color: #007bff;
        color: #007bff;
        border-radius: 8px;
        padding: 8px 20px;
        transition: all 0.3s ease-in-out;
    }
    .btn-outline-primary:hover {
        background-color: #007bff;
        color: #fff;
    }

    /* Table Styling */
    .table {
        border-radius: 10px;
        overflow: hidden;
    }
    .table thead {
        background-color: #343a40;
        color: #ffffff;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }
    .table td, .table th {
        vertical-align: middle;
        text-align: center;
    }
    .table-responsive {
        max-height: 400px;
        overflow-y: auto;
        margin-top: 20px;
    }

    /* Chart Styling */
    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    /* Badge Styling */
    .badge {
        padding: 5px 10px;
        border-radius: 12px;
    }

    /* Pagination Styling */
    .pagination .page-link {
        border-radius: 5px;
        margin: 0 2px;
        color: #007bff;
    }
    .pagination .page-item.active .page-link {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
    }

    /* SweetAlert2 Popup Styling */
    .swal2-popup {
        z-index: 9999 !important;
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: 90% !important;
        max-width: 400px !important;
        border-radius: 10px !important;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3) !important;
    }

    /* Responsive Adjustments */
    @media (max-width: 991px) {
        .content-main { margin-left: 200px; }
        .content-title { font-size: 1.5rem; }
        .form-control, .form-select, .btn-primary, .btn-outline-secondary { font-size: 0.9rem; }
        .table td, .table th { font-size: 0.9rem; }
        .chart-container { height: 250px; }
    }
    @media (max-width: 768px) {
        .content-main { margin-left: 0; padding: 15px; }
        .content-title { font-size: 1.25rem; }
        .table-responsive { max-height: 300px; }
        .table td, .table th { font-size: 0.85rem; padding: 0.5rem; }
        .card-body { padding: 1rem; }
        .form-control, .form-select { padding: 8px; }
        .btn-primary, .btn-outline-secondary { padding: 8px; }
        .chart-container { height: 200px; }
    }
    @media (max-width: 576px) {
        .content-title { font-size: 1.1rem; }
        .form-control, .form-select, .btn-primary, .btn-outline-secondary { font-size: 0.85rem; padding: 6px; }
        .table td, .table th { font-size: 0.75rem; }
        .swal2-popup {
            width: 80% !important;
            max-width: 300px !important;
        }
        .chart-container { height: 180px; }
    }
</style>

<section class="content-main">
    <div class="content-header mb-4">
        <h2 class="content-title card-title">Sales Report</h2>
    </div>

    <!-- Filter by Date and Category -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" data-bs-toggle="collapse" data-bs-target="#filterBody">
            <i class="bi bi-funnel me-2"></i>
            <h5>Filter by Date and Category</h5>
        </div>
        <div id="filterBody" class="card-body collapse show">
            <form id="filterForm" action="/admin/sales-report" method="get">
                <div class="row g-3">
                    <!-- Year and Month Filter -->
                    <div class="col-md-3">
                        <label for="year" class="form-label">Year</label>
                        <select name="year" id="year" class="form-select">
                            <option value="">Select Year</option>
                            <% years.forEach(y => { %>
                                <option value="<%= y %>" <%= year == y ? 'selected' : '' %>><%= y %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="month" class="form-label">Month</label>
                        <select name="month" id="month" class="form-select">
                            <option value="">Select Month</option>
                            <option value="1" <%= month == '1' ? 'selected' : '' %>>January</option>
                            <option value="2" <%= month == '2' ? 'selected' : '' %>>February</option>
                            <option value="3" <%= month == '3' ? 'selected' : '' %>>March</option>
                            <option value="4" <%= month == '4' ? 'selected' : '' %>>April</option>
                            <option value="5" <%= month == '5' ? 'selected' : '' %>>May</option>
                            <option value="6" <%= month == '6' ? 'selected' : '' %>>June</option>
                            <option value="7" <%= month == '7' ? 'selected' : '' %>>July</option>
                            <option value="8" <%= month == '8' ? 'selected' : '' %>>August</option>
                            <option value="9" <%= month == '9' ? 'selected' : '' %>>September</option>
                            <option value="10" <%= month == '10' ? 'selected' : '' %>>October</option>
                            <option value="11" <%= month == '11' ? 'selected' : '' %>>November</option>
                            <option value="12" <%= month == '12' ? 'selected' : '' %>>December</option>
                        </select>
                    </div>
                    <!-- Start and End Date Filter -->
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" name="startDate" id="startDate" class="form-control" aria-describedby="startDateHelp" value="<%= startDate || '' %>">
                        <small id="startDateHelp" class="form-text text-muted">Select the start date for the report.</small>
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" name="endDate" id="endDate" class="form-control" aria-describedby="endDateHelp" value="<%= endDate || '' %>">
                        <small id="endDateHelp" class="form-text text-muted">Select the end date for the report.</small>
                    </div>
                    <!-- Category Filter -->
                    <div class="col-md-3">
                        <label for="category" class="form-label">Category</label>
                        <select name="category" id="category" class="form-select">
                            <option value="">All Categories</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>
                    <!-- Buttons -->
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="d-flex w-100 gap-2">
                            <button type="submit" class="btn btn-primary w-100" id="filterBtn" data-bs-toggle="tooltip" data-bs-title="Apply filters to update the report">
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                Apply Filters
                            </button>
                            <button type="button" class="btn btn-outline-secondary w-100 download-btn" data-bs-toggle="tooltip" data-bs-title="Download the report as a PDF" onclick="downloadPDF()">Download PDF</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Total Sales -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" data-bs-toggle="collapse" data-bs-target="#totalSalesBody">
            <i class="bi bi-wallet me-2"></i>
            <h5>Total Sales</h5>
        </div>
        <div id="totalSalesBody" class="card-body collapse show">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-2">
                        <span class="badge bg-primary fs-5">₹<%= totalSales.totalRevenue.toLocaleString('en-IN') %></span>
                        <span class="text-muted">Total Revenue</span>
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="mb-2">
                        <span class="badge bg-secondary fs-5"><%= totalSales.totalOrders %></span>
                        <span class="text-muted">Total Orders</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sales by Date -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" data-bs-toggle="collapse" data-bs-target="#salesByDateBody">
            <i class="bi bi-calendar me-2"></i>
            <h5>Sales by Date</h5>
        </div>
        <div id="salesByDateBody" class="card-body collapse show">
            <% if (salesByDate.length > 0) { %>
                <div class="chart-container position-relative">
                    <div class="loading-overlay d-none" id="salesByDateLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <canvas id="salesByDateChart" aria-label="Line graph showing daily sales revenue"></canvas>
                    <figcaption class="visually-hidden">This line graph displays daily sales revenue for the selected date range.</figcaption>
                </div>
                <div class="table-responsive mt-4">
                    <table class="table table-striped table-hover" id="salesByDateTable">
                        <thead>
                            <tr>
                                <th scope="col" class="sortable" data-sort="date">Date <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="revenue">Revenue <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="orders">Orders <i class="bi bi-sort-down"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% salesByDate.forEach(day => { %>
                                <tr>
                                    <td><%= day._id %></td>
                                    <td>₹<%= day.dailyRevenue.toLocaleString('en-IN') %></td>
                                    <td><%= day.orderCount %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <nav aria-label="Table pagination" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            <% } else { %>
                <div class="text-center py-4">
                    <i class="bi bi-exclamation-circle text-muted mb-2 fs-3"></i>
                    <p class="text-muted mb-2">No sales data available for the selected filters.</p>
                    <a href="#" class="btn btn-outline-primary" onclick="document.getElementById('filterForm').reset(); document.getElementById('filterForm').submit();">Clear Filters</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Top Products -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" data-bs-toggle="collapse" data-bs-target="#topProductsBody">
            <i class="bi bi-star me-2"></i>
            <h5>Top Products <%= category ? `in ${category}` : '' %></h5>
        </div>
        <div id="topProductsBody" class="card-body collapse show">
            <% if (topProducts && topProducts.length > 0) { %>
                <div class="chart-container position-relative">
                    <div class="loading-overlay d-none" id="topProductsLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <canvas id="topProductsChart" aria-label="Bar chart showing revenue by top products"></canvas>
                    <figcaption class="visually-hidden">This bar chart displays revenue for the top products in the selected category.</figcaption>
                </div>
                <div class="table-responsive mt-4">
                    <table class="table table-striped table-hover" id="topProductsTable">
                        <thead>
                            <tr>
                                <th scope="col" class="sortable" data-sort="productName">Product Name <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="quantity">Quantity Sold <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="revenue">Revenue <i class="bi bi-sort-down"></i></th>
                                <% if (category) { %>
                                    <th scope="col">Category</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <% topProducts.forEach(product => { %>
                                <tr>
                                    <td><%= product.productName %></td>
                                    <td><%= product.totalQuantity %></td>
                                    <td>₹<%= product.totalRevenue.toLocaleString('en-IN') %></td>
                                    <% if (category) { %>
                                        <td><%= product.category %></td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <nav aria-label="Table pagination" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            <% } else { %>
                <div class="text-center py-4">
                    <i class="bi bi-exclamation-circle text-muted mb-2 fs-3"></i>
                    <p class="text-muted mb-2">No products found for the selected category.</p>
                    <a href="#" class="btn btn-outline-primary" onclick="document.getElementById('filterForm').reset(); document.getElementById('filterForm').submit();">Clear Filters</a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Top Categories -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" data-bs-toggle="collapse" data-bs-target="#topCategoriesBody">
            <i class="bi bi-tags me-2"></i>
            <h5>Top Categories</h5>
        </div>
        <div id="topCategoriesBody" class="card-body collapse show">
            <% if (!category && topCategories && topCategories.length > 0) { %>
                <div class="chart-container position-relative">
                    <div class="loading-overlay d-none" id="topCategoriesLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <canvas id="topCategoriesChart" aria-label="Bar chart showing revenue by top categories"></canvas>
                    <figcaption class="visually-hidden">This bar chart displays revenue for the top categories.</figcaption>
                </div>
                <div class="table-responsive mt-4">
                    <table class="table table-striped table-hover" id="topCategoriesTable">
                        <thead>
                            <tr>
                                <th scope="col" class="sortable" data-sort="categoryName">Category Name <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="orderCount">Order Count <i class="bi bi-sort-down"></i></th>
                                <th scope="col" class="sortable" data-sort="revenue">Revenue <i class="bi bi-sort-down"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% topCategories.forEach(cat => { %>
                                <tr>
                                    <td><%= cat.categoryName %></td>
                                    <td><%= cat.orderCount %></td>
                                    <td>₹<%= cat.totalRevenue.toLocaleString('en-IN') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <nav aria-label="Table pagination" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div>
            <% } else { %>
                <div class="text-center py-4">
                    <i class="bi bi-exclamation-circle text-muted mb-2 fs-3"></i>
                    <p class="text-muted mb-2">
                        <%= category ? 'Please clear the category filter to view top categories.' : 'No categories found for the selected filters.' %>
                    </p>
                    <a href="#" class="btn btn-outline-primary" onclick="document.getElementById('filterForm').reset(); document.getElementById('filterForm').submit();">Clear Filters</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Chart Data Preparation
    const salesByDateLabels = [<% salesByDate.forEach((day, index) => { %> "<%= day._id %>"<%= index < salesByDate.length - 1 ? ',' : '' %> <% }) %>];
    const salesByDateRevenue = [<% salesByDate.forEach((day, index) => { %> <%= day.dailyRevenue || 0 %><%= index < salesByDate.length - 1 ? ',' : '' %> <% }) %>];
    const salesByDateOrders = [<% salesByDate.forEach((day, index) => { %> <%= day.orderCount || 0 %><%= index < salesByDate.length - 1 ? ',' : '' %> <% }) %>];

    const topProductsLabels = [<% topProducts.forEach((product, index) => { %> "<%= product.productName %>"<%= index < topProducts.length - 1 ? ',' : '' %> <% }) %>];
    const topProductsRevenue = [<% topProducts.forEach((product, index) => { %> <%= product.totalRevenue || 0 %><%= index < topProducts.length - 1 ? ',' : '' %> <% }) %>];

    const topCategoriesLabels = [<% topCategories.forEach((cat, index) => { %> "<%= cat.categoryName %>"<%= index < topCategories.length - 1 ? ',' : '' %> <% }) %>];
    const topCategoriesRevenue = [<% topCategories.forEach((cat, index) => { %> <%= cat.totalRevenue || 0 %><%= index < topCategories.length - 1 ? ',' : '' %> <% }) %>];

    // Sales by Date Chart
    if (salesByDateLabels.length > 0) {
        document.getElementById('salesByDateLoading').classList.remove('d-none');
        setTimeout(() => {
            document.getElementById('salesByDateLoading').classList.add('d-none');
            new Chart(document.getElementById('salesByDateChart'), {
                type: 'line',
                data: {
                    labels: salesByDateLabels,
                    datasets: [
                        { label: 'Daily Revenue (₹)', data: salesByDateRevenue, borderColor: '#36a2eb', backgroundColor: 'rgba(54, 162, 235, 0.2)', fill: true, tension: 0.1 },
                        { label: 'Order Count', data: salesByDateOrders, borderColor: '#ff6384', backgroundColor: 'rgba(255, 99, 132, 0.2)', fill: true, tension: 0.1 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { title: { display: true, text: 'Date' } }, y: { title: { display: true, text: 'Value' }, beginAtZero: true } },
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: { callbacks: { label: context => context.dataset.label === 'Daily Revenue (₹)' ? `₹${context.raw.toLocaleString('en-IN')}` : `${context.raw} orders` } }
                    }
                }
            });
        }, 500);
    } else {
        console.log('No sales by date data available');
    }

    // Top Products Chart
    if (topProductsLabels.length > 0) {
        document.getElementById('topProductsLoading').classList.remove('d-none');
        setTimeout(() => {
            document.getElementById('topProductsLoading').classList.add('d-none');
            new Chart(document.getElementById('topProductsChart'), {
                type: 'bar',
                data: { labels: topProductsLabels, datasets: [{ label: 'Revenue (₹)', data: topProductsRevenue, backgroundColor: '#ff6384', borderColor: '#ff6384', borderWidth: 1 }] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { title: { display: true, text: 'Product' } }, y: { title: { display: true, text: 'Revenue (₹)' }, beginAtZero: true } },
                    plugins: { legend: { position: 'top' }, tooltip: { callbacks: { label: context => `₹${context.raw.toLocaleString('en-IN')}` } } }
                }
            });
        }, 500);
    } else {
        console.log('No top products data available');
    }

    // Top Categories Chart
    if (topCategoriesLabels.length > 0) {
        document.getElementById('topCategoriesLoading').classList.remove('d-none');
        setTimeout(() => {
            document.getElementById('topCategoriesLoading').classList.add('d-none');
            new Chart(document.getElementById('topCategoriesChart'), {
                type: 'bar',
                data: { labels: topCategoriesLabels, datasets: [{ label: 'Revenue (₹)', data: topCategoriesRevenue, backgroundColor: '#36a2eb', borderColor: '#36a2eb', borderWidth: 1 }] },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { title: { display: true, text: 'Category' } }, y: { title: { display: true, text: 'Revenue (₹)' }, beginAtZero: true } },
                    plugins: { legend: { position: 'top' }, tooltip: { callbacks: { label: context => `₹${context.raw.toLocaleString('en-IN')}` } } }
                }
            });
        }, 500);
    } else {
        console.log('No top categories data available');
    }

    // Toggle Date Inputs Based on Year/Month Selection
    const yearSelect = document.getElementById('year');
    const monthSelect = document.getElementById('month');
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');

    function toggleDateInputs() {
        if (yearSelect.value || monthSelect.value) {
            startDateInput.disabled = true;
            endDateInput.disabled = true;
            startDateInput.value = '';
            endDateInput.value = '';
        } else {
            startDateInput.disabled = false;
            endDateInput.disabled = false;
        }

        if (startDateInput.value || endDateInput.value) {
            yearSelect.disabled = true;
            monthSelect.disabled = true;
            yearSelect.value = '';
            monthSelect.value = '';
        } else {
            yearSelect.disabled = false;
            monthSelect.disabled = false;
        }
    }

    yearSelect.addEventListener('change', toggleDateInputs);
    monthSelect.addEventListener('change', toggleDateInputs);
    startDateInput.addEventListener('change', toggleDateInputs);
    endDateInput.addEventListener('change', toggleDateInputs);

    // Initial toggle state on page load
    toggleDateInputs();

    // PDF Download with Error Handling
    function downloadPDF() {
        const form = document.getElementById('filterForm');
        const startDate = form.querySelector('input[name="startDate"]').value;
        const endDate = form.querySelector('input[name="endDate"]').value;
        const year = form.querySelector('select[name="year"]').value;
        const month = form.querySelector('select[name="month"]').value;
        const category = form.querySelector('select[name="category"]').value;

        if (!startDate && !endDate && !year && !month) {
            Swal.fire({
                icon: 'error',
                title: 'Oops',
                text: 'Please select a date range or a year/month to download the report.',
                confirmButtonText: 'OK'
            });
            return;
        }

        let url = `/admin/sales-report?format=pdf`;
        if (startDate && endDate) {
            url += `&startDate=${startDate}&endDate=${endDate}`;
        }
        if (year) url += `&year=${year}`;
        if (month) url += `&month=${month}`;
        if (category) url += `&category=${encodeURIComponent(category)}`;

        fetch(url, { method: 'GET' })
            .then(response => {
                if (!response.ok) throw new Error('Failed to download PDF');
                return response.blob();
            })
            .then(blob => {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'sales-report.pdf';
                link.click();
            })
            .catch(error => {
                console.error('PDF Download Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops',
                    text: 'Failed to download PDF. Please try again.',
                    confirmButtonText: 'OK'
                });
            });
    }

    // Toggle sidebar function
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const contentMain = document.querySelector('.content-main');

        sidebar.classList.toggle('active');

        if (sidebar.classList.contains('active')) {
            contentMain.style.marginLeft = window.innerWidth <= 768 ? '0' : '0';
        } else {
            contentMain.style.marginLeft = window.innerWidth <= 768 ? '0' : '220px';
        }

        if (sidebar.classList.contains('active')) {
            document.addEventListener('click', closeSidebarOutside);
        } else {
            document.removeEventListener('click', closeSidebarOutside);
        }
    }

    function closeSidebarOutside(event) {
        const sidebar = document.getElementById('sidebar');
        const menuToggle = document.querySelector('.menu-toggle');
        if (!sidebar.contains(event.target) && !menuToggle.contains(event.target)) {
            sidebar.classList.remove('active');
            document.querySelector('.content-main').style.marginLeft = window.innerWidth <= 768 ? '0' : '220px';
            document.removeEventListener('click', closeSidebarOutside);
        }
    }

    window.addEventListener('load', function() {
        const sidebar = document.getElementById('sidebar');
        const contentMain = document.querySelector('.content-main');
        const menuToggle = document.querySelector('.menu-toggle');

        if (menuToggle) {
            menuToggle.addEventListener('click', toggleSidebar);
        }

        if (window.innerWidth <= 768) {
            contentMain.style.marginLeft = '0';
        }
    });

    window.addEventListener('resize', function() {
        const sidebar = document.getElementById('sidebar');
        const contentMain = document.querySelector('.content-main');

        if (window.innerWidth <= 768) {
            contentMain.style.marginLeft = '0';
        } else {
            contentMain.style.marginLeft = sidebar.classList.contains('active') ? '0' : '220px';
        }
    });
</script>

